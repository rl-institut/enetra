#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# TODO: Replace with gunicorn, collect static etc
python manage.py collectstatic -c --noinput &
python manage.py makemigrations
python manage.py migrate

# Start daphne as asgi server. make sure to bind to 0.0.0.0:8000
python -m daphne -b 0.0.0.0 -p 8000 enetra.asgi:application
